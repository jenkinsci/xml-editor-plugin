<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="File" field="file">
    <f:textbox/>
  </f:entry>
  <f:entry title="XSD schema (optional)" field="schema">
    <f:textbox/>
  </f:entry>
  <f:advanced>
    <f:entry title="Maximum file size (MB)" field="maxSizeMb">
      <f:number default="50" min="1"/>
    </f:entry>
  </f:advanced>
</j:jelly>
