<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="XPath" field="xpath">
    <f:textbox checkMethod="post"/>
  </f:entry>
  <f:entry title="XML fragment" field="fragment">
    <f:textarea/>
  </f:entry>
  <f:entry title="Position" field="position">
    <f:select default="LAST_CHILD"/>
  </f:entry>
  <f:advanced>
    <f:entry title="Expected matches" field="expected">
      <f:textbox placeholder="AT_LEAST_ONE"/>
    </f:entry>
  </f:advanced>
</j:jelly>
