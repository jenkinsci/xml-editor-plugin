<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="File" field="file">
    <f:textbox checkMethod="post"/>
  </f:entry>
  <f:entry title="XPath" field="xpath">
    <f:textbox checkMethod="post"/>
  </f:entry>
  <f:entry title="Return type" field="returnType">
    <f:select default="STRING"/>
  </f:entry>
  <f:entry field="failIfNotFound">
    <f:checkbox title="Fail if nothing matches" default="true"/>
  </f:entry>
  <f:advanced>
    <f:entry title="Default value (when nothing matches)" field="defaultValue">
      <f:textbox/>
    </f:entry>
    <f:entry title="Text (instead of file)" field="text">
      <f:textarea checkMethod="post"/>
    </f:entry>
    <f:entry field="strictNamespaces">
      <f:checkbox title="Strict namespaces"/>
    </f:entry>
    <f:entry title="Maximum file size (MB)" field="maxSizeMb">
      <f:number default="50" min="1"/>
    </f:entry>
  </f:advanced>
</j:jelly>
