<?xml version="1.0"?>
<configuration>
  <appSettings>
    <add key="Environment" value="dev" />
    <add key="ApiUrl" value="https://api.example.com/?a=1&amp;b=2" />
  </appSettings>
  <connectionStrings>
    <add name="Main" connectionString="Server=.;Database=App;Trusted_Connection=True;" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.8"/>
  </system.web>
</configuration>
